{
  "name": "codefend",
  "version": "1.0.0",
  "description": "A tool for intelligently handling package upgrades by understanding package source code changes between versions and ensuring functionality remains intact.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "codefend": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "ts-node src/index.ts",
    "dev": "ts-node src/index.ts",
    "prepublish": "npm run build",
    "test": "jest",
    "test:unit": "jest tests/unit",
    "test:integration": "RUN_INTEGRATION_TESTS=true jest tests/integration",
    "test:integration-upgrade": "RUN_INTEGRATION_TESTS=true jest tests/integration/upgrade.test.ts",
    "test:integration-openai": "RUN_INTEGRATION_TESTS=true jest tests/integration/ai/openai.test.ts",
    "test:integration-gemini": "RUN_INTEGRATION_TESTS=true jest tests/integration/ai/gemini.test.ts",
    "visualize-ast": "ts-node src/scripts/visualize-ast.ts",
    "visualize-project": "ts-node src/scripts/visualize-project.ts"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/?(*.)+(spec|test).ts"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raghavjain3/codefend.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/raghavjain3/codefend/issues"
  },
  "homepage": "https://github.com/raghavjain3/codefend#readme",
  "dependencies": {
    "@google/genai": "^0.7.0",
    "@types/node": "^22.14.0",
    "commander": "^13.1.0",
    "dotenv": "^16.4.7",
    "glob": "^11.0.1",
    "openai": "^4.93.0",
    "ora": "^5.4.1",
    "tree-sitter": "^0.21.1",
    "tree-sitter-typescript": "^0.23.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/uuid": "^10.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.3.1"
  }
}
